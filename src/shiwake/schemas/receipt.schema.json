{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiwake.invalid/schemas/receipt.schema.json",
  "title": "領収書",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "type": { "const": "receipt" },
    "issuer": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "invoice_reg_no": {
          "description": "適格請求書発行事業者登録番号。公表制度の対象なので機密ではない",
          "type": ["string", "null"],
          "pattern": "^T[0-9]{13}$"
        },
        "invoice_reg_verified": { "type": ["boolean", "null"] },
        "invoice_reg_name": { "type": ["string", "null"] }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "issued_at": { "type": ["string", "null"] },
    "currency": { "type": "string", "const": "JPY" },
    "total": { "$ref": "common.schema.json#/$defs/amount" },
    "tax_breakdown": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/taxBreakdownEntry" }
    },
    "payment": {
      "type": "object",
      "properties": {
        "method": {
          "type": ["string", "null"],
          "enum": ["cash", "credit_card", "ic_card", "bank_transfer", "direct_debit", "other", null]
        },
        "account_hint": { "type": ["string", "null"] },
        "card_last4": { "$ref": "common.schema.json#/$defs/last4" }
      },
      "required": ["method"],
      "additionalProperties": false
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": ["string", "null"] },
          "qty": { "type": ["number", "null"] },
          "unit_price": { "$ref": "common.schema.json#/$defs/amount" },
          "amount": { "$ref": "common.schema.json#/$defs/amount" },
          "tax_rate": { "type": ["number", "null"] },
          "account": { "type": ["string", "null"] }
        },
        "required": ["description", "amount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["issuer", "issued_at", "currency", "total", "tax_breakdown", "payment", "lines"],
  "unevaluatedProperties": false
}
