{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiwake.invalid/schemas/card_statement.schema.json",
  "title": "クレジットカード明細",
  "allOf": [{ "$ref": "common.schema.json#/$defs/envelope" }],
  "type": "object",
  "properties": {
    "type": { "const": "card_statement" },
    "account": {
      "description": "負債側の勘定科目。混在カードは Liabilities:Personal:* に置く",
      "type": "string"
    },
    "period": { "$ref": "common.schema.json#/$defs/period" },
    "statement_total": { "$ref": "common.schema.json#/$defs/amount" },
    "debit_date": { "$ref": "common.schema.json#/$defs/date" },
    "debit_account": { "type": ["string", "null"] },
    "card_last4": { "$ref": "common.schema.json#/$defs/last4" },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "line_id": { "type": "string", "pattern": "^L[0-9]{3,}$" },
          "date": { "$ref": "common.schema.json#/$defs/date" },
          "raw_description": { "type": "string" },
          "amount": { "$ref": "common.schema.json#/$defs/amount" },
          "account": { "type": ["string", "null"] },
          "linked_doc_id": { "type": ["string", "null"] }
        },
        "required": ["line_id", "date", "raw_description", "amount"],
        "additionalProperties": false
      }
    }
  },
  "required": ["account", "period", "statement_total", "debit_date", "transactions"],
  "unevaluatedProperties": false
}
